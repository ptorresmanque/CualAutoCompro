.pnp.js

# Build outputs
dist/
build/
.angular/cache/
.nx/cache/

# Environment files (NUNCA commitear secretos)
.env
.env.local
.env.*.local
.env.test
# .env.development is the working local env (loaded by apps/backend/src/config/env.ts);
# it gets secrets committed once accidentally — keep untracked but on disk.
.env.development
!.env.example
!.env.test.example
!.env.development.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Coverage & tests
coverage/
playwright-report/
test-results/

# Prisma local
apps/backend/prisma/*.db
apps/backend/prisma/*.db-journal

