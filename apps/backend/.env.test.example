# DATABASE_URL for backend tests. Copy this file to .env.test (gitignored) and adjust.
# Example for local Postgres on macOS (brew uses peer auth, no password):
#   DATABASE_URL=postgresql://YOUR_USERNAME:@localhost:5432/cualautocompro_test
# Example for local Postgres on Docker:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cualautocompro_test
DATABASE_URL=postgresql://:@localhost:5432/cualautocompro_test