# Local development environment. NO usar en producción.
# Para usar este archivo en lugar del .env por defecto:
#   cp apps/backend/.env.development apps/backend/.env
#
# Alternativamente, dotenv carga este archivo automáticamente
# si exportas DOTENV_CONFIG_PATH antes de `tsx watch`/`node`,
# o puedes renombrarlo a .env directamente.
DATABASE_URL=mysql://cualauto:cualauto@localhost:3306/cualautocompro?charset=utf8mb4
JWT_SECRET=dev-only-change-in-prod-please-32-bytes-min
JWT_EXPIRES_IN=7d
PORT=3000
WEB_ORIGIN=http://localhost:4200
ADMIN_EMAIL=admin@cualautocompro.cl
ADMIN_INITIAL_PASSWORD=admin1234
# NODE_ENV queda undefined a propósito; el default de Node es 'development'.
# Definir NODE_ENV=production requiere sobreescribir ADMIN_INITIAL_PASSWORD
# con un valor distinto a admin1234 (salvaguarda del proyecto).
