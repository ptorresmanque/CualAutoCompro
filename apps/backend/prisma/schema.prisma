generator client {
  provider      = "prisma-client-js"
  // binaryTargets limita la descarga del query engine a las plataformas necesarias.
  // Sin esto, Prisma descarga binarios para varias plataformas, lo que aumenta
  // el consumo de memoria durante 'prisma generate' y puede hacer fallar el
  // postinstall en hostings con LVE (cPanel compartido) por "Out of memory".
  //   - native     = plataforma actual (macOS arm64 en desarrollo)
  //   - debian-openssl-3.0.x = target correcto para cPanel/CloudLinux (RHEL/Debian/Ubuntu glibc)
  //                              CloudLinux usa glibc (es RHEL-based), NO musl.
  //                              Este target ES OBLIGATORIO: con el binario incorrecto,
  //                              Prisma cae a spawn del query engine => "cagefs_enter: Unable to fork"
  //                              bajo LVE y panics de tokio en el engine.
  //   - linux-musl-openssl-3.0.x = SOLO para Alpine / embedded. NO usar en CloudLinux.
  // Si tu hosting usa otra distro, ajusta este valor. Lista completa en:
  //   https://www.prisma.io/docs/orm/reference/prisma-schema-reference#binarytargets-options
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // NOTA: el pool de Prisma se controla con parametros en DATABASE_URL
  // (no hay setting en este schema). Por defecto Prisma usa
  // num_cpus * 2 + 1 (~13 conexiones), lo que agota los Entry Processes del
  // LVE en cPanel/CloudLinux (1 conexion TCP inactiva = 1 EP).
  //
  // Parametros configurados en DATABASE_URL (ver __tests__/env-connection-limit.spec.ts):
  //   connection_limit=10              techo del pool
  //   connect_timeout=10               timeout para abrir socket TCP
  //   pool_timeout=10                  timeout para conseguir slot libre
  //   socket_timeout=30                timeout para matar query colgada
  //   max_idle_connection_lifetime=300 cerrar conexiones MySQL inactivas (Prisma 6+)
  //
  // Si los subis, justifica el EP headroom (limite tipico de shared host: 50-100 EPs)
  // y el impacto en latencia de queries bajo carga.
}

model Brand {
  id             String           @id @default(cuid())
  name           String           @unique
  logoUrl        String?
  models         Model[]
  dealers        BrandDealer[]
  equipmentItems BrandEquipment[]
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([deletedAt])
}

model Model {
  id          String    @id @default(cuid())
  brandId     String
  name        String
  segment     String
  imageUrl    String?
  galleryUrls Json      @default("[]")
  // Nota del editor: dato curioso o aclaración que el admin quiere que el
  // usuario vea junto al modelo (tooltip en catálogo y comparador, cuadro en
  // la ficha). Opcional: la inmensa mayoría de los modelos no la tiene.
  comment     String?   @db.Text
  brand        Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions   Version[]
  favorites  Favorite[]
  popularity PopularityCounter?
  equipmentItems ModelEquipment[]
  deletedAt   DateTime?
  createdAt DateTime  @default(now())

  @@unique([brandId, name])
  @@index([segment])
  @@index([deletedAt])
}

// Enums eliminados para MariaDB: Prisma genera columnas inline ENUM(...) que
// no se pueden extender en runtime. Usamos String + constantes SEGMENTS/
// FUELS/TRANSMISSIONS en services para validar valores conocidos y permitir
// valores extendidos vía raw SQL.

model Version {
  id                    String             @id @default(cuid())
  modelId               String
  name                  String
  year                  Int
  priceClp              Int
  transmission          String
  fuel                  String
  traction              String?
  engineType            String?
  engineDisplacementCc  Int?
  powerHp               Int
  torqueNm              Int
  consumptionCityKmL    Float?
  consumptionHighwayKmL Float?
  autonomyKm            Float?
  lengthMm              Int
  widthMm               Int
  heightMm              Int
  weightKg              Int
  trunkLiters           Int
  circulationPermitClp  Int?
  mandatoryInsuranceClp Int?
  voluntaryInsuranceClp Int?
  fuelTankLiters        Float?
  batteryCapacityKwh    Float?
  hasRecall Boolean @default(false)
  recallUrl             String?
  model                 Model              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  equipmentItems        VersionEquipment[]
  equipmentExclusions   VersionEquipmentExclusion[]
  colorItems            VersionColor[]
  maintenanceCosts      MaintenanceCost[]
  comparisonItems       ComparisonItem[]
  favorites             Favorite[]
  priceHistory          VersionPriceHistory[]
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())

  @@index([modelId])
  @@index([priceClp])
  @@index([year])
  @@index([deletedAt])
}

model Color {
  id        String           @id @default(cuid())
  name      String           @unique
  hex       String?
  versions  VersionColor[]
  deletedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([deletedAt])
}

model VersionColor {
  versionId String
  colorId   String
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([versionId, colorId])
  @@index([colorId])
}

model EquipmentItem {
  id         String                      @id @default(cuid())
  name       String                      @unique
  category   String
  /// Nota del editor del ítem — ver `Model.comment`.
  comment    String?                     @db.Text
  versions   VersionEquipment[]
  brands     BrandEquipment[]
  models     ModelEquipment[]
  exclusions VersionEquipmentExclusion[]
  deletedAt  DateTime?

  @@index([deletedAt])
}

// ----------------------------------------------------------------------------
// Equipamiento: tres niveles de asociación con herencia calculada al leer.
//
//   efectivo(versión) = (propio ∪ modelo ∪ marca) − exclusiones(versión)
//
// `VersionEquipment` es el equipamiento **propio** de la versión.
// `BrandEquipment` / `ModelEquipment` son el equipamiento de serie que heredan
// todas las versiones de esa marca / modelo, existentes y futuras.
// `VersionEquipmentExclusion` es la excepción explícita: esta versión NO trae
// un ítem que su marca o modelo sí traen.
//
// La resolución vive en `src/shared/effective-equipment.ts` y NO se materializa:
// desasociar un ítem de la marca lo quita al instante de todas sus versiones.
// ----------------------------------------------------------------------------
model VersionEquipment {
  versionId       String
  equipmentItemId String
  version         Version       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@id([versionId, equipmentItemId])
}

model BrandEquipment {
  brandId         String
  equipmentItemId String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@id([brandId, equipmentItemId])
  @@index([equipmentItemId])
}

model ModelEquipment {
  modelId         String
  equipmentItemId String
  model           Model         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@id([modelId, equipmentItemId])
  @@index([equipmentItemId])
}

model VersionEquipmentExclusion {
  versionId       String
  equipmentItemId String
  version         Version       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Cascade)

  @@id([versionId, equipmentItemId])
  @@index([equipmentItemId])
}

model VersionPriceHistory {
  id           String   @id @default(cuid())
  versionId    String
  priceClp     Int
  effectiveFrom DateTime @default(now())
  note         String?
  version      Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([effectiveFrom])
}


model MaintenanceCost {
  id         String   @id @default(cuid())
  versionId  String
  mileageTag Int
  costClp    Int
  version    Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?

  @@unique([versionId, mileageTag])
  @@index([versionId])
  @@index([deletedAt])
}

model User {
  id                       String         @id @default(cuid())
  email                    String         @unique
  passwordHash             String?
  name                     String
  role                     String         @default("USER")
  createdAt                DateTime       @default(now())
  resetPasswordToken       String?        @unique
  resetPasswordExpiresAt   DateTime?
  comparisons              Comparison[]
  favorites                Favorite[]
  identities               UserIdentity[]
}

model Comparison {
  id           String           @id @default(cuid())
  userId       String
  slug         String?          @unique
  name         String?
  versionsHash String
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        ComparisonItem[]

  @@unique([userId, versionsHash])
  @@index([userId])
}

model ComparisonItem {
  id           String     @id @default(cuid())
  comparisonId String
  versionId    String
  position     Int
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  version      Version    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, position])
  @@index([versionId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  modelId   String
  versionId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  version   Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([userId, versionId])
  @@index([userId])
  @@index([modelId])
}

model Dealer {
  id        String        @id @default(cuid())
  name      String
  url       String
  logoUrl   String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  brands    BrandDealer[]

  @@index([deletedAt])
}

model BrandDealer {
  brandId  String
  dealerId String
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@id([brandId, dealerId])
  @@index([dealerId])
}

model FuelPrice {
  id              String   @id @default(cuid())
  fuelType        String
  pricePerUnitClp Float
  unit            String
  effectiveFrom   DateTime @default(now())
  deletedAt       DateTime?

  @@unique([fuelType, effectiveFrom])
  @@index([fuelType])
  @@index([deletedAt])
}

model UserIdentity {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  providerSub String
  email       String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
  @@index([email])
}

// ----------------------------------------------------------------------------
// Popularity tracking
//
// Tabla de eventos: cada vez que un usuario (anonimo o autenticado) hace click
// en "Comparar" en una ficha, se inserta un PopularityEvent. La cookie
// `cmp_uid` sirve como identificador de navegador para deduplicar duplicados
// dentro de la ventana de 30 dias (configurable en servicio).
//
// Counter cumulativo: contador all-time por modelo, util para auditoria y
// admin. NO se usa para calcular el top -- el top siempre se recalcula sobre
// eventos respetando la ventana de 30 dias (ver `popularity.service.ts`).
//
// Cascade: si se borra (soft o hard) un Model, ambos registros se eliminan
// para no dejar ids huerfanos en `/popular/models`.
// ----------------------------------------------------------------------------
model PopularityCounter {
  modelId       String   @id
  count         Int      @default(0)
  lastUpdatedAt DateTime @updatedAt
  model         Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([count])
}

model PopularityEvent {
  id        String   @id @default(cuid())
  modelId   String
  versionId String
  cookieId  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([modelId, createdAt])
  @@index([cookieId, createdAt])
}
