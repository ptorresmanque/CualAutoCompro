# Local development environment. NO usar en producción.
#
# Setup:
#   1. cp apps/backend/.env.development.example apps/backend/.env.development
#   2. Editar .env.development y agregar secretos reales (OAuth client IDs, etc.)
#   3. NO commitear .env.development (está en .gitignore)
#
# Alternativamente, dotenv carga este archivo automáticamente
# si exportas DOTENV_CONFIG_PATH antes de `tsx watch`/`node`,
# o puedes renombrarlo a .env directamente.
#
# Pool Prisma + timeouts (ver __tests__/env-connection-limit.spec.ts):
#   connection_limit=10         acota pool para no agotar los EPs del LVE en cPanel/CloudLinux
#   connect_timeout=10         segs max al abrir socket TCP
#   pool_timeout=10            segs max esperando slot libre en el pool
#   socket_timeout=30          segs max de query colgada antes de matarla
#   max_idle_connection_lifetime=300  cierra conexiones MySQL inactivas tras 5min (Prisma 6+)
DATABASE_URL=mysql://cualauto:cualauto@localhost:3306/cualautocompro?charset=utf8mb4&connection_limit=10&connect_timeout=10&pool_timeout=10&socket_timeout=30&max_idle_connection_lifetime=300
JWT_SECRET=dev-only-change-in-prod-please-32-bytes-min
JWT_EXPIRES_IN=7d
PORT=3000
WEB_ORIGIN=http://localhost:4200
ADMIN_EMAIL=admin@cualautocompro.cl
ADMIN_INITIAL_PASSWORD=admin1234
# NODE_ENV queda undefined a propósito; el default de Node es 'development'.
# Definir NODE_ENV=production requiere sobreescribir ADMIN_INITIAL_PASSWORD
# con un valor distinto a admin1234 (salvaguarda del proyecto).

# OAuth — descomentar y pegar credenciales reales. Sin envs, los botones
# sociales no se renderizan (/auth/providers devuelve {google:false, apple:false}).
#
# Google OAuth (Google Cloud Console → APIs & Services → Credentials):
#   1. Crear OAuth client tipo "Web application"
#   2. Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
#   3. Authorized JavaScript origins: http://localhost:4200
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Apple Sign in (Apple Developer → Identifiers + Keys + Service ID):
#   1. App ID con capability "Sign in with Apple"
#   2. Service ID (cliente web) con Return URL al callback
#   3. Generar private key (.p8). En env: reemplazar saltos por "\n" literal
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_TEAM_ID=
# APPLE_PRIVATE_KEY=
