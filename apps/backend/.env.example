# SECURITY: The defaults below are for local dev only.
# Override both before deploying to production.
# env.ts will refuse to boot with these defaults if NODE_ENV=production.
#
# Pool Prisma + timeouts (ver __tests__/env-connection-limit.spec.ts):
#   connection_limit=10         acota pool para no agotar los EPs del LVE en cPanel/CloudLinux
#   connect_timeout=10         segs max al abrir socket TCP
#   pool_timeout=10            segs max esperando slot libre en el pool
#   socket_timeout=30          segs max de query colgada antes de matarla
#   max_idle_connection_lifetime=300  cierra conexiones MySQL inactivas tras 5min (Prisma 6+)
DATABASE_URL=mysql://cualauto:cualauto@localhost:3306/cualautocompro?charset=utf8mb4&connection_limit=10&connect_timeout=10&pool_timeout=10&socket_timeout=30&max_idle_connection_lifetime=300
JWT_SECRET=replace-with-a-32-byte-secret-minimum
JWT_EXPIRES_IN=7d
PORT=3000
WEB_ORIGIN=http://localhost:4200
ADMIN_EMAIL=admin@cualautocompro.cl
ADMIN_INITIAL_PASSWORD=admin1234

# OAuth — opcionales. Los botones no se renderizan si el provider no esta totalmente configurado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
