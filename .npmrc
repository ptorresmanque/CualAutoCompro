# Config npm equivalente a pnpm-workspace.yaml
# Solo permite ejecutar install scripts de los paquetes con binarios nativos
# que antes estaban listados en pnpm-workspace.yaml onlyBuiltDependencies.
enable-pre-post-scripts=true
ignore-scripts=false

# Paquedes con install scripts aprobados (hash de integridad calculado por npm install)
# Mantener sincronizado con el antiguo pnpm-workspace.yaml.
